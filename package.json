{
  "name": "@agent-teams/orchestrator-repository",
  "version": "0.0.0",
  "private": true,
  "description": "Headless control plane for coordinating multi-agent teams.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "architecture:check": "pnpm run architecture:topology && pnpm run architecture:dependencies && pnpm run lint:boundaries && pnpm run architecture:conformance && pnpm run architecture:graph:advisory",
    "architecture:conformance": "pnpm --filter @agent-teams/architecture-conformance run check:conformance",
    "architecture:graph:advisory": "pnpm --filter @agent-teams/architecture-conformance run check:graph",
    "architecture:dependencies": "node scripts/architecture/validate-dependency-specifiers.mjs",
    "architecture:scaffold-package": "node scripts/architecture/scaffold-package.mjs",
    "architecture:topology": "node scripts/architecture/validate-package-topology.mjs",
    "docs:validate": "node scripts/docs/validate-docs.mjs",
    "docs:lint": "markdownlint-cli2",
    "docs:check": "pnpm run docs:validate && pnpm run docs:lint",
    "lint:boundaries": "oxlint --config .oxlintrc.json --ignore-pattern 'tooling/architecture-conformance/fixtures/invalid/**' --ignore-pattern 'tooling/architecture-conformance/fixtures/cycles/**' .",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "eslint-import-resolver-oxc": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "github-slugger": "catalog:",
    "jsdom": "catalog:",
    "markdownlint-cli2": "catalog:",
    "mdast-util-to-string": "catalog:",
    "mermaid": "catalog:",
    "oxc-resolver": "catalog:",
    "oxlint": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "remark-parse": "catalog:",
    "typescript": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:",
    "yaml": "catalog:"
  }
}
