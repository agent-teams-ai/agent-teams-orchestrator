{
  "name": "@agent-teams/orchestrator-repository",
  "version": "0.0.0",
  "private": true,
  "description": "Headless control plane for coordinating multi-agent teams.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-teams-ai/agent-teams-orchestrator.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "architecture:check": "pnpm run architecture:topology && pnpm run architecture:nx:check && pnpm run architecture:model:check && pnpm run architecture:model:test && pnpm run security:check && pnpm run reliability:check && pnpm run architecture:dependencies && pnpm run lint && pnpm run architecture:conformance && pnpm run architecture:graph:advisory",
    "architecture:conformance": "pnpm --filter @agent-teams/architecture-conformance run check:conformance",
    "architecture:graph:advisory": "pnpm --filter @agent-teams/architecture-conformance run check:graph",
    "architecture:dependencies": "node scripts/architecture/validate-dependency-specifiers.mjs",
    "architecture:model:check": "node scripts/architecture/validate-architecture-model.mjs",
    "architecture:model:format": "likec4 format architecture/likec4",
    "architecture:model:preview": "likec4 start architecture/likec4",
    "architecture:model:test": "node --test --test-concurrency=1 scripts/architecture/validate-architecture-model.test.mjs",
    "architecture:model:validate": "likec4 validate --no-layout architecture/likec4",
    "architecture:nx:check": "node scripts/architecture/validate-nx-workspace.mjs",
    "architecture:scaffold-package": "node scripts/architecture/scaffold-package.mjs",
    "architecture:topology": "node scripts/architecture/validate-package-topology.mjs",
    "docs:validate": "node scripts/docs/validate-docs.mjs",
    "docs:test": "node --test --test-concurrency=1 scripts/docs/check-doc-impact.test.mjs scripts/docs/validate-docs.test.mjs scripts/docs/validate-prose.test.mjs",
    "docs:impact": "node scripts/docs/check-doc-impact.mjs",
    "docs:query": "node scripts/docs/query-docs.mjs",
    "docs:lint": "markdownlint-cli2",
    "docs:vale": "node scripts/docs/run-vale.mjs",
    "docs:spell": "cspell --config .cspell.json --no-progress",
    "docs:prose": "pnpm run docs:vale && pnpm run docs:spell",
    "docs:check": "pnpm run docs:validate && pnpm run docs:test && pnpm run skills:check && pnpm run architecture:model:check && pnpm run docs:lint && pnpm run docs:prose",
    "foundation:assert-dev-only": "agent-teams-foundation assert-dev-only",
    "foundation:assert-registry": "agent-teams-foundation assert-registry",
    "foundation:attach": "agent-teams-foundation attach",
    "foundation:check": "agent-teams-foundation check && pnpm run foundation:assert-dev-only && pnpm run foundation:assert-registry",
    "foundation:detach": "agent-teams-foundation detach",
    "foundation:e2e": "node scripts/foundation/verify-local-mode.mjs",
    "foundation:status": "agent-teams-foundation status",
    "lint": "pnpm run lint:fast && pnpm run lint:type-aware && pnpm run lint:suppressions && pnpm run lint:test",
    "lint:advisory": "oxlint --config .oxlintrc.advisory.json --disable-nested-config . && node scripts/lint/run-type-aware.mjs --advisory",
    "lint:boundaries": "pnpm run lint:fast",
    "lint:fast": "oxlint --config .oxlintrc.json --deny-warnings --disable-nested-config .",
    "lint:fast:files": "oxlint --config .oxlintrc.json --deny-warnings --disable-nested-config --format agent --no-error-on-unmatched-pattern",
    "lint:suppressions": "node scripts/lint/validate-suppressions.mjs",
    "lint:test": "node --test --test-concurrency=1 scripts/lint/validate-lint-config.test.mjs",
    "lint:type-aware": "node scripts/lint/run-type-aware.mjs",
    "lint:type-aware:files": "node scripts/lint/run-type-aware.mjs",
    "nx:affected": "NX_NO_CLOUD=true NX_DAEMON=false nx show projects --affected",
    "nx:projects": "NX_NO_CLOUD=true NX_DAEMON=false nx show projects",
    "reliability:check": "pnpm run reliability:validate && pnpm run reliability:test",
    "reliability:test": "node --test --test-concurrency=1 scripts/reliability/validate-reliability-foundation.test.mjs",
    "reliability:validate": "node scripts/reliability/validate-reliability-foundation.mjs",
    "security:check": "pnpm run security:validate && pnpm run security:test",
    "security:test": "node --test --test-concurrency=1 scripts/security/validate-security-architecture.test.mjs",
    "security:validate": "node scripts/security/validate-security-architecture.mjs",
    "skills:check": "pnpm run skills:validate && pnpm run skills:test",
    "skills:test": "node --test --test-concurrency=1 scripts/skills/validate-skills.test.mjs",
    "skills:validate": "node scripts/skills/validate-skills.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@agent-teams/engineering-foundation": "0.3.0",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "cspell": "catalog:",
    "eslint-import-resolver-oxc": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "github-slugger": "catalog:",
    "jsdom": "catalog:",
    "likec4": "catalog:",
    "markdownlint-cli2": "catalog:",
    "mdast-util-to-string": "catalog:",
    "mermaid": "catalog:",
    "nx": "catalog:",
    "oxc-parser": "catalog:",
    "oxc-resolver": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "remark-parse": "catalog:",
    "typescript": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:",
    "yaml": "catalog:"
  }
}
