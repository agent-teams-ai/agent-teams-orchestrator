{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./.oxlintrc.base.json",
    "./node_modules/@agent-teams/engineering-foundation/presets/oxlint/type-aware.json"
  ],
  "options": {
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": false,
    "typeAware": true,
    "typeCheck": false
  },
  "overrides": [
    {
      "files": [
        "packages/platform/local-host-control/tests/**"
      ],
      "rules": {
        "complexity": ["error", 30],
        "max-depth": ["error", 5],
        "max-lines": ["error", {"max": 800, "skipBlankLines": true, "skipComments": true}],
        "max-lines-per-function": ["error", {"max": 250, "skipBlankLines": true, "skipComments": true}],
        "max-params": ["error", 6]
      }
    },
    {
      "files": [
        "packages/platform/local-host-control/src/**/*.{ts,tsx,mts,cts}",
        "packages/platform/local-host-control/tests/**/*.{ts,tsx,mts,cts}"
      ],
      "rules": {
        "typescript/await-thenable": "error",
        "typescript/ban-ts-comment": ["error", {"minimumDescriptionLength": 12, "ts-check": false, "ts-expect-error": "allow-with-description", "ts-ignore": true, "ts-nocheck": true}],
        "typescript/consistent-type-imports": "error",
        "typescript/no-confusing-void-expression": "error",
        "typescript/no-deprecated": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-floating-promises": "error",
        "typescript/no-import-type-side-effects": "error",
        "typescript/no-invalid-void-type": "error",
        "typescript/no-meaningless-void-operator": "error",
        "typescript/no-misused-promises": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/no-unnecessary-boolean-literal-compare": "error",
        "typescript/no-unnecessary-template-expression": "error",
        "typescript/no-unnecessary-type-arguments": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-unsafe-type-assertion": "error",
        "typescript/only-throw-error": "error",
        "typescript/prefer-as-const": "error",
        "typescript/prefer-nullish-coalescing": "error",
        "typescript/prefer-promise-reject-errors": "error",
        "typescript/related-getter-setter-pairs": "error",
        "typescript/require-array-sort-compare": "error",
        "typescript/restrict-plus-operands": "error",
        "typescript/restrict-template-expressions": "error",
        "typescript/return-await": "error",
        "typescript/strict-boolean-expressions": "error",
        "typescript/strict-void-return": "error",
        "typescript/switch-exhaustiveness-check": "error",
        "typescript/unbound-method": "error",
        "typescript/use-unknown-in-catch-callback-variable": "error"
      }
    },
    {
      "files": [
        "packages/platform/local-host-control/src/features/*/application/**/*.{ts,tsx,mts,cts}",
        "packages/platform/local-host-control/src/features/*/domain/**/*.{ts,tsx,mts,cts}",
        "packages/platform/local-host-control/src/features/*/contracts/**/*.{ts,tsx,mts,cts}",
        "packages/platform/local-host-control/src/features/*/projections/**/*.{ts,tsx,mts,cts}"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {"name": "Date", "message": "Receive an exact Instant or use an outbound calendar capability."},
          {"name": "console", "message": "Use a declared logging or observation port."},
          {"name": "fetch", "message": "Network access belongs in an outbound adapter."},
          {"name": "process", "message": "Process and environment access belongs in composition."},
          {"name": "setImmediate", "message": "Scheduling belongs behind a Clock, Scheduler, or Workflow port."},
          {"name": "setInterval", "message": "Scheduling belongs behind a Clock, Scheduler, or Workflow port."},
          {"name": "setTimeout", "message": "Scheduling belongs behind a Clock, Scheduler, or Workflow port."}
        ],
        "no-restricted-properties": [
          "error",
          {"object": "Math", "property": "random", "message": "Receive randomness or identifiers through an explicit port."},
          {"object": "crypto", "property": "getRandomValues", "message": "Receive randomness through an explicit port."},
          {"object": "crypto", "property": "randomUUID", "message": "Receive identifiers through an IdGenerator port."},
          {"object": "globalThis", "property": "fetch", "message": "Network access belongs in an outbound adapter."}
        ]
      }
    }
  ]
}
