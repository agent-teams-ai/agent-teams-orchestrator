{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./.oxlintrc.json"
  ],
  "jsPlugins": [],
  "categories": {
    "correctness": "error",
    "nursery": "off",
    "pedantic": "off",
    "perf": "off",
    "restriction": "off",
    "style": "off",
    "suspicious": "error"
  },
  "ignorePatterns": [
    "scripts/lint/fixtures/**",
    "tooling/architecture-conformance/fixtures/cycles/**",
    "tooling/architecture-conformance/fixtures/invalid/**"
  ],
  "rules": {
    "boundaries/dependencies": "off",
    "boundaries/no-unknown-dependencies": "off",
    "eslint/complexity": ["warn", 20],
    "eslint/max-depth": ["warn", 5],
    "eslint/max-lines-per-function": ["warn", 150],
    "eslint/max-params": ["warn", 5],
    "typescript/no-unnecessary-condition": "warn",
    "typescript/prefer-optional-chain": "warn",
    "unicorn/consistent-function-scoping": "warn",
    "unicorn/prefer-at": "warn",
    "unicorn/prefer-structured-clone": "warn"
  }
}
