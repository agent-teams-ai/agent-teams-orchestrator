{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./.oxlintrc.common.json"
  ],
  "jsPlugins": [
    {
      "name": "boundaries",
      "specifier": "eslint-plugin-boundaries"
    }
  ],
  "options": {
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": false,
    "typeAware": false,
    "typeCheck": false
  },
  "settings": {
    "boundaries/include": [
      "apps/**/src/features/**/*.{ts,tsx,mts,cts}",
      "packages/**/src/features/**/*.{ts,tsx,mts,cts}",
      "tooling/architecture-conformance-fixtures/**/src/features/**/*.{ts,tsx,mts,cts}"
    ],
    "boundaries/elements": [
      {
        "type": "domain",
        "pattern": "features/*/domain",
        "capture": [
          "feature"
        ],
        "basePattern": "**/src",
        "baseCapture": [
          "packagePath"
        ]
      },
      {
        "type": "application",
        "pattern": "features/*/application",
        "capture": [
          "feature"
        ],
        "basePattern": "**/src",
        "baseCapture": [
          "packagePath"
        ]
      },
      {
        "type": "contracts",
        "pattern": "features/*/contracts",
        "capture": [
          "feature"
        ],
        "basePattern": "**/src",
        "baseCapture": [
          "packagePath"
        ]
      },
      {
        "type": "adapter-inbound",
        "pattern": "features/*/adapters/inbound",
        "capture": [
          "feature"
        ],
        "basePattern": "**/src",
        "baseCapture": [
          "packagePath"
        ]
      },
      {
        "type": "adapter-outbound",
        "pattern": "features/*/adapters/outbound",
        "capture": [
          "feature"
        ],
        "basePattern": "**/src",
        "baseCapture": [
          "packagePath"
        ]
      },
      {
        "type": "composition",
        "pattern": "features/*/composition",
        "capture": [
          "feature"
        ],
        "basePattern": "**/src",
        "baseCapture": [
          "packagePath"
        ]
      },
      {
        "type": "feature-other",
        "pattern": "features/*",
        "capture": [
          "feature"
        ],
        "basePattern": "**/src",
        "baseCapture": [
          "packagePath"
        ]
      }
    ],
    "boundaries/files": [
      {
        "category": "domain-internal-api",
        "pattern": "**/src/features/*/domain/internal-api.ts"
      },
      {
        "category": "application-internal-api",
        "pattern": "**/src/features/*/application/internal-api.ts"
      },
      {
        "category": "test",
        "pattern": "**/*.{test,spec}.{ts,tsx,mts,cts}"
      }
    ],
    "import/resolver": {
      "oxc": {
        "tsconfig": {
          "configFile": "./tsconfig.architecture.json",
          "references": "auto"
        }
      }
    }
  },
  "rules": {
    "boundaries/no-unknown-dependencies": "error",
    "boundaries/dependencies": [
      "error",
      {
        "checkAllOrigins": true,
        "default": "disallow",
        "policies": [
          {
            "from": {
              "file": {
                "categories": "test"
              }
            },
            "allow": {
              "to": {
                "module": {
                  "origin": [
                    "core",
                    "external"
                  ]
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "domain"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": "domain",
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "domain"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": "domain",
                  "captured": {
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                },
                "file": {
                  "categories": "domain-internal-api"
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": [
                  "adapter-inbound",
                  "adapter-outbound",
                  "composition",
                  "feature-other"
                ]
              }
            },
            "allow": {
              "to": {
                "module": {
                  "origin": "core"
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "application"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "application",
                    "domain"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "application"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "domain",
                    "application"
                  ],
                  "captured": {
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                },
                "file": {
                  "categories": [
                    "domain-internal-api",
                    "application-internal-api"
                  ]
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "feature-other"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "domain",
                    "application",
                    "contracts",
                    "adapter-inbound",
                    "adapter-outbound",
                    "composition",
                    "feature-other"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "contracts"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": "contracts",
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "adapter-inbound"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "application",
                    "contracts"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "adapter-outbound"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "application",
                    "contracts",
                    "domain"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "composition"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "domain",
                    "application",
                    "contracts",
                    "adapter-inbound",
                    "adapter-outbound",
                    "composition",
                    "feature-other"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": [
                  "adapter-inbound",
                  "adapter-outbound",
                  "composition",
                  "feature-other"
                ]
              }
            },
            "allow": {
              "to": {
                "module": {
                  "origin": "external"
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": [
                  "domain",
                  "application",
                  "contracts"
                ]
              }
            },
            "disallow": {
              "to": {
                "module": {
                  "origin": "external"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/generated/**",
        "**/vendor/**"
      ],
      "rules": {
        "complexity": "off",
        "max-depth": "off",
        "max-lines": "off",
        "max-lines-per-function": "off",
        "max-params": "off"
      }
    },
    {
      "files": [
        "scripts/**/*.test.mjs",
        "scripts/**/fixtures/**",
        "tooling/architecture-conformance/**"
      ],
      "rules": {
        "complexity": [
          "error",
          30
        ],
        "max-depth": [
          "error",
          5
        ],
        "max-lines": [
          "error",
          {
            "max": 800,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-lines-per-function": [
          "error",
          {
            "max": 250,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-params": [
          "error",
          6
        ]
      }
    },
    {
      "files": [
        "tooling/architecture-conformance-fixtures/**/*.{ts,tsx,mts,cts}",
        "tooling/lint-fixtures/**/*.{ts,tsx,mts,cts}"
      ],
      "rules": {
        "typescript/await-thenable": "error",
        "typescript/ban-ts-comment": [
          "error",
          {
            "minimumDescriptionLength": 12,
            "ts-check": false,
            "ts-expect-error": "allow-with-description",
            "ts-ignore": true,
            "ts-nocheck": true
          }
        ],
        "typescript/consistent-type-imports": "error",
        "typescript/no-confusing-void-expression": "error",
        "typescript/no-deprecated": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-floating-promises": "error",
        "typescript/no-import-type-side-effects": "error",
        "typescript/no-invalid-void-type": "error",
        "typescript/no-meaningless-void-operator": "error",
        "typescript/no-misused-promises": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/no-unnecessary-boolean-literal-compare": "error",
        "typescript/no-unnecessary-template-expression": "error",
        "typescript/no-unnecessary-type-arguments": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-unsafe-type-assertion": "error",
        "typescript/only-throw-error": "error",
        "typescript/prefer-as-const": "error",
        "typescript/prefer-nullish-coalescing": "error",
        "typescript/prefer-promise-reject-errors": "error",
        "typescript/related-getter-setter-pairs": "error",
        "typescript/require-array-sort-compare": "error",
        "typescript/restrict-plus-operands": "error",
        "typescript/restrict-template-expressions": "error",
        "typescript/return-await": "error",
        "typescript/strict-boolean-expressions": "error",
        "typescript/strict-void-return": "error",
        "typescript/switch-exhaustiveness-check": "error",
        "typescript/unbound-method": "error",
        "typescript/use-unknown-in-catch-callback-variable": "error"
      }
    },
    {
      "files": [
        "tooling/lint-fixtures/core-purity/application/**/*.{ts,tsx,mts,cts}",
        "tooling/lint-fixtures/core-purity/contracts/**/*.{ts,tsx,mts,cts}",
        "tooling/lint-fixtures/core-purity/domain/**/*.{ts,tsx,mts,cts}",
        "tooling/lint-fixtures/core-purity/projections/**/*.{ts,tsx,mts,cts}"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "Date",
            "message": "Receive an exact Instant or use an outbound calendar capability."
          },
          {
            "name": "console",
            "message": "Use a declared logging or observation port."
          },
          {
            "name": "fetch",
            "message": "Network access belongs in an outbound adapter."
          },
          {
            "name": "process",
            "message": "Process and environment access belongs in composition."
          },
          {
            "name": "setImmediate",
            "message": "Scheduling belongs behind a Clock, Scheduler, or Workflow port."
          },
          {
            "name": "setInterval",
            "message": "Scheduling belongs behind a Clock, Scheduler, or Workflow port."
          },
          {
            "name": "setTimeout",
            "message": "Scheduling belongs behind a Clock, Scheduler, or Workflow port."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Receive randomness or identifiers through an explicit port."
          },
          {
            "object": "crypto",
            "property": "getRandomValues",
            "message": "Receive randomness through an explicit port."
          },
          {
            "object": "crypto",
            "property": "randomUUID",
            "message": "Receive identifiers through an IdGenerator port."
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "Network access belongs in an outbound adapter."
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "tooling/lint-fixtures/**",
    "tooling/architecture-conformance-fixtures/scaffolding/**",
    "tooling/architecture-conformance-fixtures/cycles/**",
    "tooling/architecture-conformance-fixtures/invalid/**"
  ]
}
