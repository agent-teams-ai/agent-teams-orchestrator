{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "nursery": "off",
    "pedantic": "off",
    "perf": "off",
    "restriction": "off",
    "style": "off",
    "suspicious": "error"
  },
  "jsPlugins": [
    {
      "name": "boundaries",
      "specifier": "eslint-plugin-boundaries"
    }
  ],
  "options": {
    "reportUnusedDisableDirectives": "error",
    "typeAware": false,
    "typeCheck": false
  },
  "plugins": [
    "eslint",
    "typescript",
    "oxc",
    "unicorn",
    "import",
    "jsdoc",
    "vitest",
    "promise",
    "node"
  ],
  "settings": {
    "boundaries/include": [
      "apps/**/src/features/**/*.{ts,tsx,mts,cts}",
      "packages/**/src/features/**/*.{ts,tsx,mts,cts}",
      "tooling/architecture-conformance/fixtures/**/src/features/**/*.{ts,tsx,mts,cts}"
    ],
    "boundaries/elements": [
      {
        "type": "domain",
        "pattern": "features/*/domain",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "application",
        "pattern": "features/*/application",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "contracts",
        "pattern": "features/*/contracts",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "adapter-inbound",
        "pattern": "features/*/adapters/inbound",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "adapter-outbound",
        "pattern": "features/*/adapters/outbound",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "composition",
        "pattern": "features/*/composition",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "projection",
        "pattern": "features/*/projections",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "tests",
        "pattern": "features/*/tests",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "feature-other",
        "pattern": "features/*",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      }
    ],
    "import/resolver": {
      "oxc": {
        "tsconfig": {
          "configFile": "./tsconfig.architecture.json",
          "references": "auto"
        }
      }
    }
  },
  "rules": {
    "curly": "error",
    "eqeqeq": "error",
    "import/no-duplicates": "error",
    "import/no-mutable-exports": "error",
    "import/no-self-import": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "node/no-path-concat": "error",
    "promise/no-return-wrap": "error",
    "promise/param-names": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/prefer-as-const": "error",
    "unicorn/error-message": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-useless-undefined": "error",
    "vitest/no-focused-tests": "error",
    "vitest/expect-expect": "error",
    "vitest/no-conditional-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-identical-title": "error",
    "vitest/no-test-return-statement": "error",
    "vitest/valid-expect": "error",
    "vitest/valid-expect-in-promise": "error",
    "boundaries/no-unknown-dependencies": "error",
    "boundaries/dependencies": [
      "error",
      {
        "checkAllOrigins": true,
        "default": "disallow",
        "policies": [
          {
            "from": {
              "element": {
                "type": "domain"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": "domain",
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": [
                  "adapter-inbound",
                  "adapter-outbound",
                  "composition",
                  "tests",
                  "feature-other"
                ]
              }
            },
            "allow": {
              "to": {
                "module": {
                  "origin": "core"
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "application"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "application",
                    "domain"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "contracts"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": "contracts",
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "adapter-inbound"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "application",
                    "contracts"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "adapter-outbound"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "application",
                    "contracts",
                    "domain"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "composition"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "domain",
                    "application",
                    "contracts",
                    "adapter-inbound",
                    "adapter-outbound",
                    "composition",
                    "projection",
                    "feature-other"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "projection"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "domain",
                    "application",
                    "contracts",
                    "projection"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": [
                  "tests",
                  "feature-other"
                ]
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "domain",
                    "application",
                    "contracts",
                    "adapter-inbound",
                    "adapter-outbound",
                    "composition",
                    "projection",
                    "tests",
                    "feature-other"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": [
                  "adapter-inbound",
                  "adapter-outbound",
                  "composition",
                  "tests",
                  "feature-other"
                ]
              }
            },
            "allow": {
              "to": {
                "module": {
                  "origin": "external"
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": [
                  "domain",
                  "application",
                  "contracts",
                  "projection"
                ]
              }
            },
            "disallow": {
              "to": {
                "module": {
                  "origin": "external"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "apps/**/src/features/*/application/**/*.{ts,tsx,mts,cts}",
        "apps/**/src/features/*/domain/**/*.{ts,tsx,mts,cts}",
        "apps/**/src/features/*/contracts/**/*.{ts,tsx,mts,cts}",
        "apps/**/src/features/*/projections/**/*.{ts,tsx,mts,cts}",
        "packages/**/src/features/*/application/**/*.{ts,tsx,mts,cts}",
        "packages/**/src/features/*/domain/**/*.{ts,tsx,mts,cts}",
        "packages/**/src/features/*/contracts/**/*.{ts,tsx,mts,cts}",
        "packages/**/src/features/*/projections/**/*.{ts,tsx,mts,cts}",
        "scripts/lint/fixtures/core-purity/application/**/*.{ts,tsx,mts,cts}",
        "scripts/lint/fixtures/core-purity/contracts/**/*.{ts,tsx,mts,cts}",
        "scripts/lint/fixtures/core-purity/domain/**/*.{ts,tsx,mts,cts}",
        "scripts/lint/fixtures/core-purity/projections/**/*.{ts,tsx,mts,cts}"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "Date",
            "message": "Receive an exact Instant or use an outbound calendar capability."
          },
          {
            "name": "console",
            "message": "Use a declared logging or observation port."
          },
          {
            "name": "fetch",
            "message": "Network access belongs in an outbound adapter."
          },
          {
            "name": "process",
            "message": "Process and environment access belongs in composition."
          },
          {
            "name": "setImmediate",
            "message": "Scheduling belongs behind a Clock, Scheduler, or Workflow port."
          },
          {
            "name": "setInterval",
            "message": "Scheduling belongs behind a Clock, Scheduler, or Workflow port."
          },
          {
            "name": "setTimeout",
            "message": "Scheduling belongs behind a Clock, Scheduler, or Workflow port."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Receive randomness or identifiers through an explicit port."
          },
          {
            "object": "crypto",
            "property": "getRandomValues",
            "message": "Receive randomness through an explicit port."
          },
          {
            "object": "crypto",
            "property": "randomUUID",
            "message": "Receive identifiers through an IdGenerator port."
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "Network access belongs in an outbound adapter."
          }
        ]
      }
    }
  ]
}
