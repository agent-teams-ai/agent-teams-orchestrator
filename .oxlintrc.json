{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    {
      "name": "boundaries",
      "specifier": "eslint-plugin-boundaries"
    }
  ],
  "settings": {
    "boundaries/include": [
      "apps/**/src/features/**/*.{ts,tsx,mts,cts}",
      "packages/**/src/features/**/*.{ts,tsx,mts,cts}",
      "tooling/architecture-conformance/fixtures/**/src/features/**/*.{ts,tsx,mts,cts}"
    ],
    "boundaries/elements": [
      {
        "type": "domain",
        "pattern": "features/*/domain",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "application",
        "pattern": "features/*/application",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "contracts",
        "pattern": "features/*/contracts",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "adapter-inbound",
        "pattern": "features/*/adapters/inbound",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "adapter-outbound",
        "pattern": "features/*/adapters/outbound",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "composition",
        "pattern": "features/*/composition",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "projection",
        "pattern": "features/*/projections",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "tests",
        "pattern": "features/*/tests",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      },
      {
        "type": "feature-other",
        "pattern": "features/*",
        "capture": ["feature"],
        "basePattern": "**/src",
        "baseCapture": ["packagePath"]
      }
    ],
    "import/resolver": {
      "oxc": {
        "tsconfig": {
          "configFile": "./tsconfig.architecture.json",
          "references": "auto"
        }
      }
    }
  },
  "rules": {
    "boundaries/no-unknown-dependencies": "error",
    "boundaries/dependencies": [
      "error",
      {
        "checkAllOrigins": true,
        "default": "disallow",
        "policies": [
          {
            "from": {
              "element": {
                "type": "domain"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": "domain",
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": [
                  "adapter-inbound",
                  "adapter-outbound",
                  "composition",
                  "tests",
                  "feature-other"
                ]
              }
            },
            "allow": {
              "to": {
                "module": {
                  "origin": "core"
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "application"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "application",
                    "domain"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "contracts"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": "contracts",
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "adapter-inbound"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "application",
                    "contracts"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "adapter-outbound"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "application",
                    "contracts",
                    "domain"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "composition"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "domain",
                    "application",
                    "contracts",
                    "adapter-inbound",
                    "adapter-outbound",
                    "composition",
                    "projection",
                    "feature-other"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "projection"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "domain",
                    "application",
                    "contracts",
                    "projection"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": [
                  "tests",
                  "feature-other"
                ]
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": [
                    "domain",
                    "application",
                    "contracts",
                    "adapter-inbound",
                    "adapter-outbound",
                    "composition",
                    "projection",
                    "tests",
                    "feature-other"
                  ],
                  "captured": {
                    "feature": "{{ from.element.captured.feature }}",
                    "packagePath": "{{ from.element.captured.packagePath }}"
                  }
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": [
                  "adapter-inbound",
                  "adapter-outbound",
                  "composition",
                  "tests",
                  "feature-other"
                ]
              }
            },
            "allow": {
              "to": {
                "module": {
                  "origin": "external"
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": [
                  "domain",
                  "application",
                  "contracts",
                  "projection"
                ]
              }
            },
            "disallow": {
              "to": {
                "module": {
                  "origin": "external"
                }
              }
            }
          }
        ]
      }
    ]
  }
}
