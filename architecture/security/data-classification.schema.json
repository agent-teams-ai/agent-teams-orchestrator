{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.ai/schemas/security/data-classification-manifest.v1.schema.json",
  "title": "Agent Teams data classification manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "owner",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "surface",
        "classification",
        "tenantScope",
        "retentionClass",
        "redactionProfile",
        "exportPolicy",
        "containsUserContent",
        "containsAuthorityEvidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "surface": {
          "enum": [
            "public-contract",
            "integration-event",
            "feed",
            "blob",
            "telemetry"
          ]
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "sensitive",
            "secret",
            "authority-evidence"
          ]
        },
        "tenantScope": {
          "enum": [
            "none",
            "tenant",
            "project",
            "resource"
          ]
        },
        "retentionClass": {
          "enum": [
            "transient",
            "operational",
            "durable",
            "audit",
            "policy-governed"
          ]
        },
        "redactionProfile": {
          "enum": [
            "none",
            "standard",
            "user-content",
            "secret",
            "authority-evidence",
            "metadata-only"
          ]
        },
        "exportPolicy": {
          "enum": [
            "unrestricted",
            "tenant-authorized",
            "restricted",
            "prohibited"
          ]
        },
        "containsUserContent": {
          "type": "boolean"
        },
        "containsAuthorityEvidence": {
          "type": "boolean"
        }
      }
    }
  }
}
