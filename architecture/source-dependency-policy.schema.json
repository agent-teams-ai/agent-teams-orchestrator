{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/source-dependency-policy.json",
  "title": "Agent Teams Orchestrator source dependency policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "default",
    "edges",
    "feature_edges"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "default": {
      "const": "deny"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "feature_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/featureEdge"
      }
    }
  },
  "$defs": {
    "packageId": {
      "type": "string",
      "pattern": "^(app|context|integration|platform|sdk|testing)\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "exportSubpath": {
      "type": "string",
      "pattern": "^\\./[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
    },
    "featureName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "internalSurface": {
      "enum": [
        "domain",
        "application"
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "imports"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/packageId"
        },
        "to": {
          "$ref": "#/$defs/packageId"
        },
        "imports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exportSubpath"
          }
        }
      }
    },
    "featureEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "from",
        "to",
        "imports"
      ],
      "properties": {
        "package": {
          "$ref": "#/$defs/packageId"
        },
        "from": {
          "$ref": "#/$defs/featureName"
        },
        "to": {
          "$ref": "#/$defs/featureName"
        },
        "imports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/internalSurface"
          }
        }
      }
    }
  }
}
