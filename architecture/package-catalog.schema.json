{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/package-catalog.json",
  "title": "Agent Teams Orchestrator package catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "packages"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "documentId": {
      "type": "string",
      "pattern": "^(ADR-[0-9]{4}|OD-[0-9]{3}|[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+)$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "enum": [
                  "app.local-supervisor",
                  "app.orchestrator-local",
                  "sdk.orchestrator-local-host"
                ]
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "materialization": {},
              "materialization_blocked_by": {},
              "materialization_decision": {}
            },
            "required": [
              "materialization",
              "materialization_blocked_by",
              "materialization_decision"
            ]
          }
        }
      ],
      "required": [
        "id",
        "role",
        "path",
        "package_name",
        "owner_document"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(app|context|integration|platform|sdk|testing)\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
        },
        "role": {
          "enum": [
            "app",
            "bounded-context",
            "integration",
            "platform",
            "sdk",
            "testing"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(apps|packages)/[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
        },
        "package_name": {
          "type": "string",
          "pattern": "^@agent-teams/[a-z][a-z0-9-]*$"
        },
        "owner_document": {
          "$ref": "#/$defs/documentId"
        },
        "materialization": {
          "enum": [
            "allowed",
            "deferred"
          ]
        },
        "materialization_blocked_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/documentId"
          }
        },
        "materialization_decision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/documentId"
            }
          ]
        }
      }
    }
  }
}
