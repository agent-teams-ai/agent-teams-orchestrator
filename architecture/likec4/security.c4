model {
  securityLandscape = applicationBoundary 'Orchestrator Security Landscape' {
    metadata {
      owner_document 'architecture.security'
      security_role 'security-landscape'
      trust_zone 'cross-zone'
    }

    localDevice = trustBoundary 'Local User Device' {
      metadata {
        owner_document 'architecture.security'
        security_role 'trust-boundary'
        trust_zone 'local-device'
      }

      desktop = securityClient 'Desktop App' {
        metadata {
          owner_document 'architecture.security'
          security_role 'desktop-client'
          trust_zone 'local-device'
        }
      }

      cli = securityClient 'CLI' {
        metadata {
          owner_document 'architecture.security'
          security_role 'cli-client'
          trust_zone 'local-device'
        }
      }

      runtimeConnector = securityProcess 'Local Runtime Connector' {
        metadata {
          owner_document 'OD-038'
          security_role 'runtime-connector'
          trust_zone 'local-device'
          decision_status 'connectivity-unresolved'
        }
      }

      supervisor = securityProcess 'Local Supervisor' {
        metadata {
          owner_document 'architecture.security'
          security_role 'local-supervisor'
          trust_zone 'local-device'
        }
      }

      host = securityProcess 'Local Orchestrator Host' {
        metadata {
          owner_document 'architecture.security'
          security_role 'orchestrator-host'
          trust_zone 'local-device'
        }
      }

      runtimeWorker = trustBoundary 'Local Runtime Enforcement Zone' {
        metadata {
          owner_document 'architecture.runtime-boundary'
          security_role 'trust-boundary'
          trust_zone 'runtime-execution'
        }

        runtime = runtimeEndpoint 'Local ar Runtime' {
          metadata {
            owner_document 'architecture.runtime-boundary'
            security_role 'agent-runtime'
            trust_zone 'runtime-execution'
          }
        }
      }

      nats = eventBroker 'Managed Local NATS JetStream' {
        metadata {
          owner_document 'architecture.eventing'
          security_role 'event-broker'
          trust_zone 'local-device'
        }
      }

      realtime = securityProcess 'Managed Local Centrifugo' {
        metadata {
          owner_document 'architecture.sdk-transports'
          security_role 'client-realtime-edge'
          trust_zone 'local-device'
        }
      }

      database = stateStore 'Local SQLite Stores' {
        metadata {
          owner_document 'architecture.persistence'
          security_role 'state-store'
          trust_zone 'local-device'
        }
      }
    }

    browserDevice = trustBoundary 'Browser Device' {
      metadata {
        owner_document 'architecture.security'
        security_role 'trust-boundary'
        trust_zone 'browser-device'
      }

      browser = securityClient 'Browser App' {
        metadata {
          owner_document 'architecture.security'
          security_role 'browser-client'
          trust_zone 'browser-device'
        }
      }
    }

    hostedControlPlane = trustBoundary 'Hosted Control Plane' {
      metadata {
        owner_document 'architecture.security'
        security_role 'trust-boundary'
        trust_zone 'hosted-control-plane'
      }

      host = securityProcess 'Hosted Orchestrator Host' {
        metadata {
          owner_document 'architecture.security'
          security_role 'orchestrator-host'
          trust_zone 'hosted-control-plane'
        }
      }

      nats = eventBroker 'Hosted NATS JetStream' {
        metadata {
          owner_document 'architecture.eventing'
          security_role 'event-broker'
          trust_zone 'hosted-control-plane'
        }
      }

      realtime = securityProcess 'Hosted Centrifugo Edge' {
        metadata {
          owner_document 'architecture.sdk-transports'
          security_role 'client-realtime-edge'
          trust_zone 'hosted-control-plane'
        }
      }

      database = stateStore 'Hosted PostgreSQL Stores' {
        metadata {
          owner_document 'architecture.persistence'
          security_role 'state-store'
          trust_zone 'hosted-control-plane'
        }
      }
    }

    runtimeWorker = trustBoundary 'Runtime Worker Trust Zone' {
      metadata {
        owner_document 'architecture.runtime-boundary'
        security_role 'trust-boundary'
        trust_zone 'runtime-worker'
      }

      runtime = runtimeEndpoint 'Remote ar Runtime' {
        metadata {
          owner_document 'architecture.runtime-boundary'
          security_role 'agent-runtime'
          trust_zone 'runtime-worker'
        }
      }
    }

    externalZone = trustBoundary 'External Systems' {
      metadata {
        owner_document 'architecture.security'
        security_role 'trust-boundary'
        trust_zone 'external'
      }

      identityAuthority = externalIntegration 'Identity Authority' {
        metadata {
          owner_document 'domain.contexts.identity-registry'
          security_role 'external-integration'
          trust_zone 'external'
          decision_status 'provider-unresolved'
        }
      }

      managedProductAuthority = externalIntegration 'Managed Product Authority' {
        metadata {
          owner_document 'OD-012'
          security_role 'managed-product-authority'
          trust_zone 'external'
          decision_status 'authority-unresolved'
        }
      }

      commercialAccessAuthority = externalIntegration 'Commercial Access Authority' {
        metadata {
          owner_document 'OD-037'
          security_role 'commercial-access-authority'
          trust_zone 'external'
          decision_status 'commercial-authority-unresolved'
        }
      }

      standaloneAuthority = externalIntegration 'Standalone Deployment Authority' {
        metadata {
          owner_document 'OD-012'
          security_role 'standalone-product-authority'
          trust_zone 'external'
          decision_status 'authority-unresolved'
        }
      }

      taskBoards = externalIntegration 'Task Boards' {
        metadata {
          owner_document 'domain.contexts.work-coordination'
          security_role 'external-integration'
          trust_zone 'external'
        }
      }

      webEndpoints = externalIntegration 'Webhooks and External APIs' {
        metadata {
          owner_document 'architecture.security'
          security_role 'external-integration'
          trust_zone 'external'
        }
      }
    }
  }

  securityLandscape.localDevice.desktop -[authenticatedControl]-> securityLandscape.localDevice.host 'Scoped local control API' {
    metadata {
      integration_style 'Authenticated local control channel'
      authority 'Authenticated context and resource scope establish authority; payload fields do not'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.cli -[authenticatedControl]-> securityLandscape.localDevice.host 'Scoped local control API' {
    metadata {
      integration_style 'Authenticated local control channel'
      authority 'Authenticated context and resource scope establish authority; payload fields do not'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.desktop -[lifecycleControl]-> securityLandscape.localDevice.supervisor 'Discover and ensure local Host' {
    metadata {
      integration_style 'OS-protected bootstrap channel'
      authority 'Supervisor owns process availability only; it does not authorize business commands'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.cli -[lifecycleControl]-> securityLandscape.localDevice.supervisor 'Discover and ensure local Host' {
    metadata {
      integration_style 'OS-protected bootstrap channel'
      authority 'Supervisor owns process availability only; it does not authorize business commands'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.supervisor -[lifecycleControl]-> securityLandscape.localDevice.host 'Start, health, drain, and activate' {
    metadata {
      integration_style 'Versioned process lifecycle protocol'
      authority 'Supervisor owns availability; Host owns orchestration behavior'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.supervisor -[lifecycleControl]-> securityLandscape.localDevice.realtime 'Start, health, stage, and activate' {
    metadata {
      integration_style 'Pinned bundled sidecar lifecycle'
      authority 'Supervisor owns process availability only; Host adapter owns realtime semantics'
      status 'accepted'
    }
  }
  securityLandscape.browserDevice.browser -[authenticatedControl]-> securityLandscape.hostedControlPlane.host 'HTTPS control API' {
    metadata {
      integration_style 'Untrusted-network authenticated control channel'
      authority 'Server-derived identity and scope are authoritative; browser payload is untrusted'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.desktop -[authenticatedControl]-> securityLandscape.hostedControlPlane.host 'Remote HTTPS control API' {
    metadata {
      integration_style 'Untrusted-network authenticated control channel'
      authority 'Hosted identity and resource scope are authoritative; local client payload is untrusted'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.cli -[authenticatedControl]-> securityLandscape.hostedControlPlane.host 'Remote HTTPS control API' {
    metadata {
      integration_style 'Untrusted-network authenticated control channel'
      authority 'Hosted identity and resource scope are authoritative; local client payload is untrusted'
      status 'accepted'
    }
  }
  securityLandscape.hostedControlPlane.host -[authenticatedControl]-> securityLandscape.browserDevice.browser 'Issue scoped hosted subscription authority' {
    metadata {
      integration_style 'Short-lived audience-bound realtime subscription token'
      authority 'Host authorizes channels before edge connection; client fields never grant scope'
      status 'accepted'
    }
  }
  securityLandscape.hostedControlPlane.host -[authenticatedControl]-> securityLandscape.localDevice.desktop 'Issue scoped remote subscription authority' {
    metadata {
      integration_style 'Short-lived audience-bound realtime subscription token'
      authority 'Host authorizes channels before edge connection; client fields never grant scope'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.desktop -[eventDelivery]-> securityLandscape.localDevice.realtime 'Scoped local live subscriptions' {
    metadata {
      integration_style 'Centrifugo live edge with bounded recovery cache'
      authority 'Host-issued token scopes subscription; SQL feed and Connect reconciliation remain authoritative'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.host -[eventDelivery]-> securityLandscape.localDevice.realtime 'Publish authorized client feed projections' {
    metadata {
      integration_style 'Replaceable client realtime adapter after durable feed commit'
      authority 'Owning feature owns feed and classification; edge owns connection fanout only'
      status 'accepted'
    }
  }
  securityLandscape.browserDevice.browser -[eventDelivery]-> securityLandscape.hostedControlPlane.realtime 'Scoped hosted live subscriptions' {
    metadata {
      integration_style 'Centrifugo live edge with short-lived subscription token'
      authority 'Hosted Host owns authorization and authoritative resync'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.desktop -[eventDelivery]-> securityLandscape.hostedControlPlane.realtime 'Scoped remote live subscriptions' {
    metadata {
      integration_style 'Centrifugo live edge over untrusted network'
      authority 'Hosted Host owns authorization and authoritative resync'
      status 'accepted'
    }
  }
  securityLandscape.hostedControlPlane.host -[eventDelivery]-> securityLandscape.hostedControlPlane.realtime 'Publish authorized client feed projections' {
    metadata {
      integration_style 'Replaceable client realtime adapter after durable feed commit'
      authority 'Owning feature owns feed and classification; edge owns connection fanout only'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.host -[runtimeControl]-> securityLandscape.localDevice.runtimeWorker.runtime 'Consumer-owned runtime ports through ACL' {
    metadata {
      integration_style 'ar Runtime Published Language through stateless ACL'
      authority 'Orchestrator owns product authorization; ar owns technical enforcement'
      status 'accepted'
    }
  }
  securityLandscape.hostedControlPlane.host -[runtimeControl]-> securityLandscape.runtimeWorker.runtime 'Consumer-owned runtime ports through ACL' {
    metadata {
      integration_style 'ar Runtime Published Language through stateless ACL'
      authority 'Orchestrator owns product authorization; ar owns technical enforcement'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.runtimeConnector -[authenticatedControl]-> securityLandscape.hostedControlPlane.host 'Outbound enrolled runtime channel' {
    metadata {
      integration_style 'Mutually authenticated target-bound channel with connection generation'
      authority 'OD-038 must qualify enrollment, revocation, reconnect, and custody before this placement is advertised'
      status 'proposed'
    }
  }
  securityLandscape.hostedControlPlane.host -[runtimeControl]-> securityLandscape.localDevice.runtimeConnector 'Logical runtime control over enrolled channel' {
    metadata {
      integration_style 'Consumer-owned runtime ports over the connector channel'
      authority 'Desktop does not own the Run or RuntimeSession; stale channel generations cannot mutate execution'
      status 'proposed'
    }
  }
  securityLandscape.localDevice.runtimeConnector -[runtimeControl]-> securityLandscape.localDevice.runtimeWorker.runtime 'Forward qualified runtime control locally' {
    metadata {
      integration_style 'Versioned local AR protocol through stateless connector ACL'
      authority 'AR owns technical enforcement; connector owns connectivity only'
      status 'proposed'
    }
  }
  securityLandscape.localDevice.host -[eventDelivery]-> securityLandscape.localDevice.nats 'Integration events and durable delivery' {
    metadata {
      integration_style 'Broker-neutral event ports through managed local JetStream adapter'
      authority 'Owning bounded context owns event semantics; broker owns delivery mechanics'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.nats -[eventDelivery]-> securityLandscape.localDevice.host 'Deliver subscribed events' {
    metadata {
      integration_style 'At-least-once local JetStream consumer delivery'
      authority 'Consumer inbox and owning use case validate scope, idempotency, and event semantics'
      status 'accepted'
    }
  }
  securityLandscape.hostedControlPlane.host -[eventDelivery]-> securityLandscape.hostedControlPlane.nats 'Integration events and durable delivery' {
    metadata {
      integration_style 'Broker-neutral event ports through hosted JetStream adapter'
      authority 'Owning bounded context owns event semantics; broker owns delivery mechanics'
      status 'accepted'
    }
  }
  securityLandscape.hostedControlPlane.nats -[eventDelivery]-> securityLandscape.hostedControlPlane.host 'Deliver subscribed events' {
    metadata {
      integration_style 'At-least-once hosted JetStream consumer delivery'
      authority 'Consumer inbox and owning use case validate scope, idempotency, and event semantics'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.host -[stateAccess]-> securityLandscape.localDevice.database 'Context-owned state, inbox, outbox, and feeds' {
    metadata {
      integration_style 'Context-owned SQLite persistence adapters'
      authority 'Each bounded context owns its state and transaction boundary'
      status 'accepted'
    }
  }
  securityLandscape.hostedControlPlane.host -[stateAccess]-> securityLandscape.hostedControlPlane.database 'Context-owned state, inbox, outbox, and feeds' {
    metadata {
      integration_style 'Context-owned PostgreSQL persistence adapters'
      authority 'Each bounded context owns its state and transaction boundary'
      status 'accepted'
    }
  }
  securityLandscape.hostedControlPlane.host -[authenticatedControl]-> securityLandscape.externalZone.identityAuthority 'Authenticate and obtain identity evidence' {
    metadata {
      integration_style 'Provider-neutral identity adapter'
      authority 'Identity provider selection is unresolved; the configured product authority provider owns product authorization; provider topology is open under OD-012'
      status 'proposed'
    }
  }
  securityLandscape.hostedControlPlane.host -[authenticatedControl]-> securityLandscape.externalZone.managedProductAuthority 'Verify managed product authority' {
    metadata {
      integration_style 'Managed product authority adapter with short-lived target-bound evidence'
      authority 'OD-012 gates identity, grants, tenant isolation, and revocation; Platform does not proxy normal data traffic'
      status 'proposed'
    }
  }
  securityLandscape.hostedControlPlane.host -[authenticatedControl]-> securityLandscape.externalZone.commercialAccessAuthority 'Optionally verify commercial capability evidence' {
    metadata {
      integration_style 'Host-custodied capability lease through feature-owned decision ports'
      authority 'OD-037 gates only the independently advertised managed-commercial-entitlements capability, not baseline profile availability'
      status 'proposed'
    }
  }
  securityLandscape.hostedControlPlane.host -[authenticatedControl]-> securityLandscape.externalZone.standaloneAuthority 'Verify standalone deployment authority' {
    metadata {
      integration_style 'Replaceable standalone authority adapter selected by composition'
      authority 'Standalone baseline does not depend on managed Platform authority'
      status 'proposed'
    }
  }
  securityLandscape.localDevice.host -[controlledEgress]-> securityLandscape.externalZone.taskBoards 'Policy-checked task-board requests' {
    metadata {
      integration_style 'Feature-owned adapter through controlled egress port'
      authority 'Owning integration defines intent; egress adapter enforces destination policy'
      status 'accepted'
    }
  }
  securityLandscape.hostedControlPlane.host -[controlledEgress]-> securityLandscape.externalZone.taskBoards 'Policy-checked task-board requests' {
    metadata {
      integration_style 'Feature-owned adapter through controlled egress port'
      authority 'Owning integration defines intent; egress adapter enforces destination policy'
      status 'accepted'
    }
  }
  securityLandscape.localDevice.host -[controlledEgress]-> securityLandscape.externalZone.webEndpoints 'Policy-checked outbound HTTP' {
    metadata {
      integration_style 'Controlled egress adapter with destination validation'
      authority 'Application intent cannot bypass egress policy or resolve arbitrary private destinations'
      status 'accepted'
    }
  }
  securityLandscape.hostedControlPlane.host -[controlledEgress]-> securityLandscape.externalZone.webEndpoints 'Policy-checked outbound HTTP' {
    metadata {
      integration_style 'Controlled egress adapter with destination validation'
      authority 'Application intent cannot bypass egress policy or resolve arbitrary private destinations'
      status 'accepted'
    }
  }
  securityLandscape.externalZone.webEndpoints -[externalPort]-> securityLandscape.hostedControlPlane.host 'Authenticated inbound webhook or callback' {
    metadata {
      integration_style 'Feature-owned inbound adapter with signature, replay, scope, and schema validation'
      authority 'External payload is untrusted; owning use case and Access Control determine product consequence'
      status 'proposed'
    }
  }
}
