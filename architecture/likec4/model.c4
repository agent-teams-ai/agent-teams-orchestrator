model {
  identityRegistry = boundedContext 'Identity Registry' {
    metadata {
      package_id 'context.identity-registry'
      document_id 'domain.contexts.identity-registry'
    }
  }

  accessControl = boundedContext 'Access Control' {
    metadata {
      package_id 'context.access-control'
      document_id 'domain.contexts.access-control'
    }
  }

  orchestrationScope = boundedContext 'Orchestration Scope' {
    metadata {
      package_id 'context.orchestration-scope'
      document_id 'domain.contexts.orchestration-scope'
    }
  }

  workspaceRegistry = boundedContext 'Workspace Registry' {
    metadata {
      package_id 'context.workspace-registry'
      document_id 'domain.contexts.workspace-registry'
    }
  }

  teamTopology = boundedContext 'Team Topology' {
    metadata {
      package_id 'context.team-topology'
      document_id 'domain.contexts.team-topology'
    }
  }

  agentOrganization = boundedContext 'Agent Organization' {
    metadata {
      package_id 'context.agent-organization'
      document_id 'domain.contexts.agent-organization'
    }
  }

  workCoordination = boundedContext 'Work Coordination' {
    metadata {
      package_id 'context.work-coordination'
      document_id 'domain.contexts.work-coordination'
    }
  }

  runOrchestration = boundedContext 'Run Orchestration' {
    metadata {
      package_id 'context.run-orchestration'
      document_id 'domain.contexts.run-orchestration'
    }
  }

  executionObservation = boundedContext 'Execution Observation' {
    metadata {
      package_id 'context.execution-observation'
      document_id 'domain.contexts.execution-observation'
    }
  }

  agentCommunication = boundedContext 'Agent Communication' {
    metadata {
      package_id 'context.agent-communication'
      document_id 'domain.contexts.agent-communication'
    }
  }

  humanNotification = boundedContext 'Human Notification Management' {
    metadata {
      package_id 'context.human-notification'
      document_id 'domain.contexts.human-notification'
    }
  }

  agentAttention = boundedContext 'Agent Attention' {
    metadata {
      package_id 'context.agent-attention'
      document_id 'domain.contexts.agent-attention'
    }
  }

  agentContext = boundedContext 'Agent Context' {
    metadata {
      package_id 'context.agent-context'
      document_id 'domain.contexts.agent-context'
    }
  }

  policyRisk = boundedContext 'Policy and Risk' {
    metadata {
      package_id 'context.policy-risk'
      document_id 'domain.contexts.policy-risk'
    }
  }

  approvalManagement = boundedContext 'Approval Management' {
    metadata {
      package_id 'context.approval-management'
      document_id 'domain.contexts.approval-management'
    }
  }

  usageMetering = boundedContext 'Usage Metering' {
    metadata {
      package_id 'context.usage-metering'
      document_id 'domain.contexts.usage-metering'
    }
  }

  usageAccounting = boundedContext 'Usage Accounting' {
    metadata {
      package_id 'context.usage-accounting'
      document_id 'domain.contexts.usage-accounting'
    }
  }

  consumptionGovernance = boundedContext 'Consumption Governance' {
    metadata {
      package_id 'context.consumption-governance'
      document_id 'domain.contexts.consumption-governance'
    }
  }

  runtimeAcl = integrationModule 'Stateless Runtime ACL' {
    metadata {
      owner_document 'architecture.runtime-boundary'
    }
  }

  agentRuntime = externalSystem 'ar Runtime' {
    metadata {
      owner_document 'architecture.runtime-boundary'
    }
  }

  taskBoardAcls = integrationModule 'Task Board ACLs' {
    metadata {
      owner_document 'domain.contexts.work-coordination'
    }
  }

  applicationUseCases = applicationBoundary 'Application use cases' {
    metadata {
      owner_document 'architecture.dependency-rules'
    }
  }

  identityRegistry -[publishedFacts]-> accessControl 'Principal facts' {
    metadata {
      integration_style 'Published principal facts'
      authority 'Identity owns identity; the configured product authority provider owns grants; Access holds context-local grant projections'
      status 'proposed'
    }
  }
  orchestrationScope -[publishedFacts]-> accessControl 'Orchestration scope facts' {
    metadata {
      integration_style 'Versioned scope identity and lifecycle facts'
      authority 'Scope owns orchestration identity and lifecycle; authority provider owns grants'
      status 'proposed'
    }
  }
  accessControl -[decisionContract]-> applicationUseCases 'Authorization facts' {
    metadata {
      integration_style 'Consumer-owned decision port or context-local grant projection'
      authority 'The configured product authority provider owns grant facts; Access supplies context-local projections; consumer owns operation policy'
      status 'proposed'
    }
  }
  orchestrationScope -[publishedFacts]-> workspaceRegistry 'Project identity and admission facts' {
    metadata {
      integration_style 'Published tenant and project references'
      authority 'Scope owns identity and admission; Workspace owns registration'
      status 'accepted'
    }
  }
  orchestrationScope -[publishedFacts]-> teamTopology 'Project identity and admission facts' {
    metadata {
      integration_style 'Published tenant and project references'
      authority 'Scope owns identity and admission; Team owns roster and team lifecycle'
      status 'accepted'
    }
  }
  orchestrationScope -[publishedFacts]-> agentOrganization 'Tenant and project identity' {
    metadata {
      integration_style 'Published tenant and project references'
      authority 'Scope owns orchestration identity; Organization owns semantic hierarchy'
      status 'accepted'
    }
  }
  orchestrationScope -[publishedFacts]-> workCoordination 'Project identity and admission facts' {
    metadata {
      integration_style 'Published tenant and project references'
      authority 'Scope owns identity and admission; Work owns work lifecycle'
      status 'accepted'
    }
  }
  orchestrationScope -[publishedFacts]-> runOrchestration 'Project and runtime-scope admission facts' {
    metadata {
      integration_style 'Published tenant and project references'
      authority 'Scope owns identity, admission, and RuntimeScopeBinding; Run owns Run lifecycle and targets'
      status 'accepted'
    }
  }
  orchestrationScope -[publishedFacts]-> executionObservation 'Project identity and disposition facts' {
    metadata {
      integration_style 'Published tenant, project, admission, freeze, and deletion-epoch facts'
      authority 'Scope owns orchestration identity and disposition; Observation owns its evidence and projections'
      status 'accepted'
    }
  }
  orchestrationScope -[publishedFacts]-> usageMetering 'Scope identity' {
    metadata {
      integration_style 'Published tenant and project references'
      authority 'Scope owns orchestration identity; Metering owns measurement'
      status 'proposed'
    }
  }
  orchestrationScope -[publishedFacts]-> usageAccounting 'Scope identity' {
    metadata {
      integration_style 'Published tenant and project references'
      authority 'Scope owns orchestration identity; Accounting owns attribution and rating'
      status 'proposed'
    }
  }
  orchestrationScope -[publishedFacts]-> consumptionGovernance 'Scope identity' {
    metadata {
      integration_style 'Published tenant and project references'
      authority 'Scope owns orchestration identity; Governance owns budget and quota decisions'
      status 'proposed'
    }
  }
  teamTopology -[publishedFacts]-> agentOrganization 'Team facts' {
    metadata {
      integration_style 'Versioned team facts'
      authority 'Team owns roster and lifecycle; Organization owns placements'
      status 'proposed'
    }
  }
  teamTopology -[publishedFacts]-> workCoordination 'Topology facts' {
    metadata {
      integration_style 'Versioned team facts'
      authority 'Team owns roster and lifecycle; Work owns assignments'
      status 'proposed'
    }
  }
  teamTopology -[publishedFacts]-> runOrchestration 'Topology facts' {
    metadata {
      integration_style 'Versioned team facts'
      authority 'Team owns roster and lifecycle; Run owns execution policy'
      status 'proposed'
    }
  }
  runOrchestration -[consumerPort]-> teamTopology 'Team creation or selection request' {
    metadata {
      integration_style 'Narrow application boundary requested by the team-activation feature'
      authority 'Run owns the team-activation process; Team owns CreateTeam, versions, roster, and Team invariants'
      status 'accepted'
    }
  }
  runOrchestration -[consumerPort]-> agentOrganization 'Optional placement command' {
    metadata {
      integration_style 'Narrow application boundary requested by the team-activation feature'
      authority 'Run owns the team-activation process; Organization owns semantic placement'
      status 'accepted'
    }
  }
  agentOrganization -[publishedFacts]-> accessControl 'Structure facts' {
    metadata {
      integration_style 'Versioned structure facts'
      authority 'Organization owns hierarchy; the configured product authority provider owns grants; Access holds context-local grant projections'
      status 'proposed'
    }
  }
  agentOrganization -[publishedFacts]-> usageAccounting 'Attribution scope' {
    metadata {
      integration_style 'Versioned structure facts'
      authority 'Organization owns hierarchy; Accounting owns attribution'
      status 'proposed'
    }
  }
  workspaceRegistry -[publishedFacts]-> policyRisk 'Workspace facts' {
    metadata {
      integration_style 'Workspace facts and opaque references'
      authority 'Workspace owns registration; Policy owns trust'
      status 'proposed'
    }
  }
  workspaceRegistry -[publishedFacts]-> runOrchestration 'Workspace identity' {
    metadata {
      integration_style 'Workspace facts and opaque references'
      authority 'Workspace owns allocations; Run owns activation consequences'
      status 'proposed'
    }
  }
  workCoordination -[publishedFacts]-> runOrchestration 'Work execution requested' {
    metadata {
      integration_style 'Versioned execution requests'
      authority 'Work owns WorkExecution and work lifecycle; Run owns placement'
      status 'proposed'
    }
  }
  runOrchestration -[publishedFacts]-> workCoordination 'Placement and execution facts' {
    metadata {
      integration_style 'Versioned execution facts'
      authority 'Run owns placement; Work owns execution lifecycle consequences'
      status 'proposed'
    }
  }
  runOrchestration -[publishedFacts]-> executionObservation 'Run attribution and cutoff facts' {
    metadata {
      integration_style 'Versioned Run, participant, binding, and cutoff facts'
      authority 'Run owns execution intent and lifecycle; Observation owns user-facing evidence interpretation'
      status 'accepted'
    }
  }
  policyRisk -[decisionContract]-> runOrchestration 'Policy decisions' {
    metadata {
      integration_style 'Policy decision contract'
      authority 'Policy owns risk decisions; Run applies them'
      status 'proposed'
    }
  }
  consumptionGovernance -[decisionContract]-> runOrchestration 'Consumption decisions' {
    metadata {
      integration_style 'Reservation and consumption decision contract'
      authority 'Governance owns budget and quota decisions; Run applies them'
      status 'proposed'
    }
  }
  runOrchestration -[publishedFacts]-> approvalManagement 'Approval requested' {
    metadata {
      integration_style 'Versioned approval request'
      authority 'Run owns execution intent; Approval owns product decision lifecycle'
      status 'proposed'
    }
  }
  approvalManagement -[publishedFacts]-> runOrchestration 'Approval decided' {
    metadata {
      integration_style 'Versioned approval facts'
      authority 'Approval owns product decision; Run owns consequence'
      status 'proposed'
    }
  }
  runOrchestration -[publishedFacts]-> agentCommunication 'Delivery intent' {
    metadata {
      integration_style 'Versioned delivery intent'
      authority 'Run owns run policy; Communication owns product delivery'
      status 'proposed'
    }
  }
  agentCommunication -[publishedFacts]-> runOrchestration 'Delivery facts' {
    metadata {
      integration_style 'Versioned delivery facts'
      authority 'Communication owns product delivery; Run owns run consequence'
      status 'proposed'
    }
  }
  workCoordination -[publishedFacts]-> agentCommunication 'Handoff intent' {
    metadata {
      integration_style 'Versioned handoff intent'
      authority 'Work owns work lifecycle; Communication owns delivery'
      status 'proposed'
    }
  }
  agentCommunication -[publishedFacts]-> workCoordination 'Handoff facts' {
    metadata {
      integration_style 'Versioned handoff facts'
      authority 'Communication owns delivery; Work owns work consequence'
      status 'proposed'
    }
  }
  workCoordination -[publishedFacts]-> humanNotification 'Work facts' {
    metadata {
      integration_style 'Producer-owned versioned work facts'
      authority 'Work owns source facts; Notification owns human presentation'
      status 'proposed'
    }
  }
  workCoordination -[publishedFacts]-> agentAttention 'Work facts' {
    metadata {
      integration_style 'Producer-owned versioned work facts'
      authority 'Work owns source facts; Attention owns agent orientation need'
      status 'proposed'
    }
  }
  agentCommunication -[publishedFacts]-> humanNotification 'Conversation facts' {
    metadata {
      integration_style 'Producer-owned versioned conversation facts'
      authority 'Communication owns dialogue; Notification owns human presentation'
      status 'proposed'
    }
  }
  agentCommunication -[publishedFacts]-> agentAttention 'Conversation facts' {
    metadata {
      integration_style 'Producer-owned versioned conversation facts'
      authority 'Communication owns dialogue; Attention owns agent orientation need'
      status 'proposed'
    }
  }
  workCoordination -[publishedFacts]-> agentContext 'Work context facts' {
    metadata {
      integration_style 'Producer-owned versioned Work facts through a consumer ACL'
      authority 'Work owns source facts; Agent Context owns disclosed semantic composition'
      status 'proposed'
    }
  }
  agentCommunication -[publishedFacts]-> agentContext 'Conversation context facts' {
    metadata {
      integration_style 'Producer-owned versioned Conversation facts through a consumer ACL'
      authority 'Communication owns dialogue; Agent Context owns disclosed semantic composition'
      status 'proposed'
    }
  }
  agentAttention -[publishedFacts]-> agentContext 'Orientation evidence' {
    metadata {
      integration_style 'Versioned orientation intent without source content'
      authority 'Attention owns orientation need; Agent Context owns semantic composition'
      status 'proposed'
    }
  }
  teamTopology -[publishedFacts]-> agentContext 'Team context facts' {
    metadata {
      integration_style 'Producer-owned versioned Team facts through a consumer ACL'
      authority 'Team owns roster and lifecycle; Agent Context owns disclosed semantic composition'
      status 'proposed'
    }
  }
  accessControl -[decisionContract]-> agentContext 'Authorization decisions as evidence' {
    metadata {
      integration_style 'Decision facts consumed as evidence, not copied authority'
      authority 'The configured product authority provider owns grant facts; Agent Context owns semantic composition'
      status 'proposed'
    }
  }
  policyRisk -[decisionContract]-> agentContext 'Policy decisions as evidence' {
    metadata {
      integration_style 'Decision facts consumed as evidence, not copied authority'
      authority 'Policy owns risk decisions; Agent Context owns semantic composition'
      status 'proposed'
    }
  }
  consumptionGovernance -[decisionContract]-> agentContext 'Consumption decisions as evidence' {
    metadata {
      integration_style 'Decision facts consumed as evidence, not copied authority'
      authority 'Governance owns budget and quota decisions; Agent Context owns semantic composition'
      status 'proposed'
    }
  }
  agentContext -[publishedFacts]-> runOrchestration 'Context readiness evidence' {
    metadata {
      integration_style 'Versioned manifest readiness and materialization evidence'
      authority 'Agent Context owns semantic evidence; Run owns activation consequences'
      status 'proposed'
    }
  }
  agentAttention -[publishedFacts]-> runOrchestration 'Orientation intent' {
    metadata {
      integration_style 'Versioned orientation intent'
      authority 'Attention owns orientation need; Run owns activation consequences'
      status 'proposed'
    }
  }
  orchestrationScope -[consumerPort]-> runtimeAcl 'Runtime scope admission, binding, and disposition commands' {
    metadata {
      integration_style 'Scope-owned consumer ports through stateless ACL'
      authority 'Orchestration Scope owns project admission, binding, and disposition intent; AR owns technical scope authority; ACL translates only'
      status 'accepted'
    }
  }
  runOrchestration -[consumerPort]-> runtimeAcl 'Runtime target, session, and operation commands' {
    metadata {
      integration_style 'Consumer-owned runtime ports'
      authority 'Run owns orchestration intent; ACL translates only'
      status 'accepted'
    }
  }
  runtimeAcl -[aclTranslation]-> agentRuntime 'Runtime Published Language' {
    metadata {
      integration_style 'Anti-Corruption Layer translation'
      authority 'AR owns execution; ACL owns translation'
      status 'accepted'
    }
  }
  agentRuntime -[observation]-> runtimeAcl 'Runtime facts' {
    metadata {
      integration_style 'AR Published Language'
      authority 'AR owns runtime facts; ACL translates only'
      status 'accepted'
    }
  }
  runtimeAcl -[observation]-> orchestrationScope 'Runtime scope receipts and observations' {
    metadata {
      integration_style 'Typed receipts and resumable consumer-owned scope observation ingestion'
      authority 'AR owns runtime truth; Orchestration Scope owns bindings, checkpoints, and local projections; ACL translates only'
      status 'accepted'
    }
  }
  runtimeAcl -[observation]-> runOrchestration 'Runtime target and session observations' {
    metadata {
      integration_style 'Consumer-owned observation projection'
      authority 'AR owns runtime facts; Run owns its observation projection'
      status 'accepted'
    }
  }
  runtimeAcl -[observation]-> executionObservation 'Runtime control and output evidence' {
    metadata {
      integration_style 'Consumer-owned evidence admission through stateless ACL translation'
      authority 'AR owns runtime facts; Observation owns admitted product evidence and activity; ACL translates only'
      status 'accepted'
    }
  }
  runtimeAcl -[observation]-> usageMetering 'Usage observations' {
    metadata {
      integration_style 'Consumer-owned usage ingestion'
      authority 'AR owns runtime facts; Metering owns normalized measurement'
      status 'proposed'
    }
  }
  runOrchestration -[publishedFacts]-> usageMetering 'Attribution hints' {
    metadata {
      integration_style 'Versioned attribution hints'
      authority 'Run owns execution context; Metering owns normalized measurement'
      status 'proposed'
    }
  }
  usageMetering -[publishedFacts]-> usageAccounting 'Metered usage' {
    metadata {
      integration_style 'Exact normalized usage facts'
      authority 'Metering owns measurement; Accounting owns attribution and rating'
      status 'proposed'
    }
  }
  usageAccounting -[publishedFacts]-> consumptionGovernance 'Usage and cost facts' {
    metadata {
      integration_style 'Rated usage and cost facts'
      authority 'Accounting owns attribution and rating; Governance owns limits'
      status 'proposed'
    }
  }
  workCoordination -[externalPort]-> taskBoardAcls 'Board operations' {
    metadata {
      integration_style 'Consumer-owned board ports and external mappings'
      authority 'Work owns canonical work semantics; ACL translates only'
      status 'proposed'
    }
  }
}
